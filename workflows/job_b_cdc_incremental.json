          "checkpoint_products_path": "{{job.parameters.checkpoint_products_path}}"
        }
      },
      "environment_key": "serverless_env"
    },
    {
      "task_key": "order_items_adjustment_simulator",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/04_order_items_adjustment_simulator",
