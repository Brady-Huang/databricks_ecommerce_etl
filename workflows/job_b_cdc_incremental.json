{
  "name": "ecommerce_cdc_incremental",
  "tags": {
    "project": "ecommerce_etl_demo",
    "stage": "cdc"
  },
  "job_clusters": [],
  "tasks": [
    {
      "task_key": "customers_cdc_simulator",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/04_customers_cdc_simulator",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
