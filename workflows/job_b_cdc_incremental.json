      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/05_order_items_adjustment_apply",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "cdc_landing_order_items_path": "{{job.parameters.cdc_landing_order_items_path}}",
          "checkpoint_order_items_path": "{{job.parameters.checkpoint_order_items_path}}"
        }
      },
      "environment_key": "serverless_env"
    }
  ],
  "environments": [
    {
      "environment_key": "serverless_env",
      "spec": {
        "client": "3"
      }
    }
  ],
  "parameters": [
    { "name": "catalog", "default": "ecommerce_demo" },
    { "name": "cdc_landing_customers_path", "default": "/Volumes/ecommerce_demo/raw/cdc_landing/customers" },
    { "name": "checkpoint_customers_path", "default": "/Volumes/ecommerce_demo/raw/_checkpoints/cdc_customers" },
    { "name": "num_change_customers_events", "default": "300" },
    { "name": "cdc_landing_orders_path", "default": "/Volumes/ecommerce_demo/raw/cdc_landing/orders" },
    { "name": "checkpoint_orders_path", "default": "/Volumes/ecommerce_demo/raw/_checkpoints/cdc_orders" },
    { "name": "num_change_orders_events", "default": "300" },
    { "name": "cdc_landing_products_path", "default": "/Volumes/ecommerce_demo/raw/cdc_landing/products" },
    { "name": "checkpoint_products_path", "default": "/Volumes/ecommerce_demo/raw/_checkpoints/cdc_products" },
    { "name": "num_change_products_events", "default": "150" },
    { "name": "cdc_landing_order_items_path", "default": "/Volumes/ecommerce_demo/raw/cdc_landing/order_items" },
    { "name": "checkpoint_order_items_path", "default": "/Volumes/ecommerce_demo/raw/_checkpoints/order_items_adjustments" },
    { "name": "num_change_order_items_events", "default": "150" }
  ],
  "schedule": {
    "quartz_cron_expression": "0 */15 * * * ?",
    "timezone_id": "Asia/Taipei",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "description": "CDC 增量同步 Job，每 15 分鐘觸發一次，涵蓋四條互相獨立、可平行執行的 CDC 支線：customers(SCD1)、orders(SCD2)、products(SCD2)、order_items(獨立調整事件表，append-only)。四條支線彼此沒有依賴關係。正式環境接上真實 Postgres 時，各支線的模擬器 task(04開頭)會被 Lakeflow Connect 的 ingestion pipeline 取代，套用邏輯(05開頭)基本不需要修改。widget 參數命名皆加上表名前綴，避免不同 notebook 之間的 widget 命名衝突(此為實際開發過程中踩過的坑)。"
}