    },
    {
      "task_key": "orders_cdc_apply",
      "depends_on": [{ "task_key": "orders_cdc_simulator" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/05_orders_cdc_apply",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "cdc_landing_orders_path": "{{job.parameters.cdc_landing_orders_path}}",
          "checkpoint_orders_path": "{{job.parameters.checkpoint_orders_path}}"
        }
      },
      "environment_key": "serverless_env"
    },
    {
      "task_key": "products_cdc_simulator",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/04_products_cdc_simulator",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "cdc_landing_products_path": "{{job.parameters.cdc_landing_products_path}}",
