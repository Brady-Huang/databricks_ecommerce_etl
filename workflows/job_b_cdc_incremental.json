    },
    {
      "task_key": "products_cdc_apply",
      "depends_on": [{ "task_key": "products_cdc_simulator" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/05_products_cdc_apply",
