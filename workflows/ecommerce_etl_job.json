{
  "name": "ecommerce_medallion_etl",
  "tags": {
    "project": "ecommerce_etl_demo"
  },
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 2,
        "data_security_mode": "SINGLE_USER"
      }
    }
  ],
  "tasks": [
    {
      "task_key": "generate_sample_data",
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/ecommerce_etl/notebooks/00_generate_sample_data",
        "base_parameters": {
          "catalog": "ecommerce_demo",
          "landing_volume_path": "/Volumes/ecommerce_demo/raw/landing",
          "num_customers": "5000",
          "num_products": "500",
          "num_orders": "20000",
          "num_web_events": "80000",
          "inject_dirty_data": "true"
        }
      }
    },
    {
      "task_key": "bronze_ingestion",
      "depends_on": [{ "task_key": "generate_sample_data" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/ecommerce_etl/notebooks/01_bronze_ingestion",
        "base_parameters": {
          "catalog": "ecommerce_demo",
          "landing_volume_path": "/Volumes/ecommerce_demo/raw/landing",
          "checkpoint_path": "/Volumes/ecommerce_demo/raw/_checkpoints"
        }
      }
    },
    {
      "task_key": "silver_transformation",
      "depends_on": [{ "task_key": "bronze_ingestion" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/ecommerce_etl/notebooks/02_silver_transformation",
        "base_parameters": {
          "catalog": "ecommerce_demo"
        }
      }
    },
    {
      "task_key": "cdc_source_simulator",
      "depends_on": [{ "task_key": "silver_transformation" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/ecommerce_etl/notebooks/04_cdc_source_simulator",
        "base_parameters": {
          "catalog": "ecommerce_demo",
          "cdc_landing_path": "/Volumes/ecommerce_demo/raw/cdc_landing/customers",
          "num_change_events": "300"
        }
      }
    },
    {
      "task_key": "cdc_ingestion_and_apply",
      "depends_on": [{ "task_key": "cdc_source_simulator" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/ecommerce_etl/notebooks/05_cdc_ingestion_and_apply",
        "base_parameters": {
          "catalog": "ecommerce_demo",
          "cdc_landing_path": "/Volumes/ecommerce_demo/raw/cdc_landing/customers",
          "checkpoint_path": "/Volumes/ecommerce_demo/raw/_checkpoints/cdc_customers"
        }
      }
    },
    {
      "task_key": "gold_aggregation",
      "depends_on": [{ "task_key": "cdc_ingestion_and_apply" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/ecommerce_etl/notebooks/03_gold_aggregation",
        "base_parameters": {
          "catalog": "ecommerce_demo"
        }
      }
    },
    {
      "task_key": "churn_feature_table",
      "depends_on": [{ "task_key": "gold_aggregation" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/ecommerce_etl/notebooks/06_churn_feature_table",
        "base_parameters": {
          "catalog": "ecommerce_demo",
          "observation_date": "2026-05-01",
          "churn_window_days": "90",
          "min_tenure_days": "30",
          "lookback_days": "180"
        }
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "Asia/Taipei",
    "pause_status": "PAUSED"
  },
  "email_notifications": {
    "on_failure": []
  },
  "max_concurrent_runs": 1
}
