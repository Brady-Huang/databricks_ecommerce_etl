{
  "name": "ecommerce_initial_snapshot",
  "tags": {
    "project": "ecommerce_etl_demo",
    "stage": "initial_load"
  },
  "job_clusters": [],
  "tasks": [
    {
      "task_key": "generate_sample_data",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/00_generate_sample_data",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "landing_volume_path": "{{job.parameters.landing_volume_path}}",
          "num_customers": "{{job.parameters.num_customers}}",
          "num_products": "{{job.parameters.num_products}}",
          "num_orders": "{{job.parameters.num_orders}}",
          "num_web_events": "{{job.parameters.num_web_events}}",
          "inject_dirty_data": "{{job.parameters.inject_dirty_data}}"
        }
      },
      "environment_key": "serverless_env"
    },
    {
      "task_key": "bronze_ingestion",
      "depends_on": [{ "task_key": "generate_sample_data" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/01_bronze_ingestion",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "landing_volume_path": "{{job.parameters.landing_volume_path}}",
          "checkpoint_path": "{{job.parameters.checkpoint_path}}"
        }
      },
      "environment_key": "serverless_env"
    },
    {
      "task_key": "silver_transformation",
      "depends_on": [{ "task_key": "bronze_ingestion" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/02_silver_transformation",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}"
        }
      },
      "environment_key": "serverless_env"
    },
    {
      "task_key": "gold_aggregation",
      "depends_on": [{ "task_key": "silver_transformation" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/brady120915@gmail.com/databricks_ecommerce_etl_v2/notebooks/03_gold_aggregation",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}"
        }
      },
      "environment_key": "serverless_env"
    }
  ],
  "environments": [
    {
      "environment_key": "serverless_env",
      "spec": {
        "client": "3"
      }
    }
  ],
  "parameters": [
    { "name": "catalog", "default": "ecommerce_demo" },
    { "name": "landing_volume_path", "default": "/Volumes/ecommerce_demo/raw/landing" },
    { "name": "checkpoint_path", "default": "/Volumes/ecommerce_demo/raw/_checkpoints" },
    { "name": "num_customers", "default": "5000" },
    { "name": "num_products", "default": "500" },
    { "name": "num_orders", "default": "20000" },
    { "name": "num_web_events", "default": "80000" },
    { "name": "inject_dirty_data", "default": "true" }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 2 1 1 ? 2099",
    "timezone_id": "Asia/Taipei",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "description": "一次性的批次歷史回填(Initial Snapshot)。包含資料生成(00)、Bronze/Silver/Gold 全流程。只在環境初始化或需要重建資料時手動觸發，不應設定為固定排程。"
}
